diff --git a/app/src/main/res/values/tv_player_styles.xml b/app/src/main/res/values/tv_player_styles.xml
new file mode 100644
index 0000000..fee356e
--- /dev/null
+++ b/app/src/main/res/values/tv_player_styles.xml
@@ -0,0 +1,21 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <!-- Tanukifin: TV player buttons -->
+    <style name="TvPlayerButton">
+        <item name="android:layout_width">56dp</item>
+        <item name="android:layout_height">56dp</item>
+        <item name="android:layout_marginEnd">22dp</item>
+        <item name="android:padding">13dp</item>
+        <item name="android:scaleType">fitCenter</item>
+        <item name="android:background">@drawable/ripple_background_circular</item>
+        <item name="android:focusable">true</item>
+        <item name="tint">#FFFFFFFF</item>
+    </style>
+    <style name="TvPlayerText">
+        <item name="android:textColor">#FFF7F7FC</item>
+        <item name="android:shadowColor">#CC000000</item>
+        <item name="android:shadowRadius">6</item>
+        <item name="android:shadowDy">1</item>
