+package org.jellyfin.mobile.webapp;
+
+import java.net.URI;
+import java.util.Locale;
+import java.util.Objects;
+
+/** Exact HTTP(S) origin. Reject ambiguous/user-info URLs before comparing. */
+final class ServerOrigin {
+    private final String scheme;
+    private final String host;
+    private final int port;
+
+    private ServerOrigin(String scheme, String host, int port) {
+        this.scheme = scheme;
+        this.host = host;
+        this.port = port;
+    }
+
+    public String getRule() { return scheme + "://" + host + ":" + port; }
+
+    public boolean allows(String value) { return equals(parse(value)); }
+
+    public static ServerOrigin parse(String value) {
+        if (value == null) return null;
+        for (int i = 0; i < value.length(); i++) {
+            char c = value.charAt(i);
+            if (c <= ' ' || c == '\\' || c == 127) return null;
+        }
+        try {
+            URI uri = new URI(value);
+            String scheme = uri.getScheme();
+            if (scheme == null) return null;
+            scheme = scheme.toLowerCase(Locale.ROOT);
+            if (!scheme.equals("http") && !scheme.equals("https")) return null;
+            if (uri.isOpaque() || uri.getRawUserInfo() != null) return null;
+            String host = uri.getHost();
+            if (host == null || host.isEmpty() || host.contains("%")) return null;
+            host = host.toLowerCase(Locale.ROOT);
+            int port = uri.getPort();
+            if (port == -1) port = scheme.equals("https") ? 443 : 80;
+            if (port < 1 || port > 65535) return null;
+            return new ServerOrigin(scheme, host, port);
+        } catch (java.net.URISyntaxException e) {
+            return null;
+        }
+    }
+
+    @Override public boolean equals(Object other) {
+        if (!(other instanceof ServerOrigin)) return false;
+        ServerOrigin value = (ServerOrigin) other;
+        return scheme.equals(value.scheme) && host.equals(value.host) && port == value.port;
+    }
+
+    @Override public int hashCode() { return Objects.hash(scheme, host, port); }
+}
