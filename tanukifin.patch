diff --git a/app/src/main/res/layout-television/exo_player_control_view.xml b/app/src/main/res/layout-television/exo_player_control_view.xml
new file mode 100644
index 0000000..c0a148c
--- /dev/null
+++ b/app/src/main/res/layout-television/exo_player_control_view.xml
@@ -0,0 +1,363 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+    Tanukifin: TV player controls, laid out like the official Jellyfin Fire TV / Android TV player.
+    Keeps every view id of the phone layout (layout/exo_player_control_view.xml) with the same view types,
+    so the existing player code works unchanged.
+-->
+<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:app="http://schemas.android.com/apk/res-auto"
+    android:id="@+id/player_controls"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent">
+
+    <!-- Gradients so text stays readable over bright video -->
+    <View
+        android:id="@+id/tv_scrim_top"
+        android:layout_width="0dp"
+        android:layout_height="200dp"
+        android:background="@drawable/tv_scrim_top"
+        app:layout_constraintEnd_toEndOf="parent"
+        app:layout_constraintStart_toStartOf="parent"
+        app:layout_constraintTop_toTopOf="parent" />
+
+    <View
+        android:id="@+id/tv_scrim_bottom"
+        android:layout_width="0dp"
+        android:layout_height="280dp"
+        android:background="@drawable/tv_scrim_bottom"
+        app:layout_constraintBottom_toBottomOf="parent"
+        app:layout_constraintEnd_toEndOf="parent"
+        app:layout_constraintStart_toStartOf="parent" />
+
+    <!-- Kept for the shared player code, not shown on TV -->
+    <androidx.appcompat.widget.Toolbar
+        android:id="@+id/toolbar"
+        android:layout_width="0dp"
+        android:layout_height="wrap_content"
+        android:visibility="gone"
+        app:layout_constraintEnd_toEndOf="parent"
+        app:layout_constraintStart_toStartOf="parent"
+        app:layout_constraintTop_toTopOf="parent" />
+
+    <!-- Top left: title logo and episode line -->
+    <ImageView
+        android:id="@+id/tv_logo"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:layout_marginStart="48dp"
+        android:layout_marginTop="32dp"
+        android:adjustViewBounds="true"
+        android:importantForAccessibility="no"
+        android:maxWidth="320dp"
+        android:maxHeight="72dp"
+        android:scaleType="fitStart"
+        android:visibility="gone"
+        app:layout_constraintStart_toStartOf="parent"
+        app:layout_constraintTop_toTopOf="parent" />
+
+    <TextView
+        android:id="@+id/tv_title"
+        style="@style/TvPlayerText"
+        android:layout_width="0dp"
+        android:layout_height="wrap_content"
+        android:layout_marginStart="48dp"
+        android:layout_marginTop="10dp"
+        android:layout_marginEnd="24dp"
+        android:ellipsize="end"
+        android:maxLines="2"
+        android:textSize="22sp"
+        app:layout_constraintEnd_toStartOf="@id/tv_clock"
+        app:layout_constraintStart_toStartOf="parent"
+        app:layout_constraintTop_toBottomOf="@id/tv_logo"
+        app:layout_goneMarginTop="32dp" />
+
+    <!-- Top right: clock -->
+    <TextClock
+        android:id="@+id/tv_clock"
+        style="@style/TvPlayerText"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:layout_marginTop="34dp"
+        android:layout_marginEnd="48dp"
+        android:textSize="26sp"
+        app:layout_constraintEnd_toEndOf="parent"
+        app:layout_constraintTop_toTopOf="parent" />
+
+    <!-- Row 1: play/pause, rewind, forward, subtitles, audio -->
+    <LinearLayout
+        android:id="@+id/tv_row_main"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:layout_marginStart="40dp"
+        android:layout_marginBottom="6dp"
+        android:gravity="center_vertical"
+        android:orientation="horizontal"
+        app:layout_constraintBottom_toTopOf="@id/seek_bar_container"
+        app:layout_constraintStart_toStartOf="parent">
+
+        <FrameLayout
+            android:id="@+id/play_pause_container"
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content">
+
+            <androidx.appcompat.widget.AppCompatImageButton
+                android:id="@+id/exo_play_pause"
+                style="@style/TvPlayerButton" />
+        </FrameLayout>
+
+        <androidx.appcompat.widget.AppCompatImageButton
+            android:id="@+id/tv_rewind_button"
+            style="@style/TvPlayerButton"
+            android:contentDescription="Rewind"
+            android:src="@drawable/ic_tv_rewind" />
+
+        <androidx.appcompat.widget.AppCompatImageButton
+            android:id="@+id/tv_fast_forward_button"
+            style="@style/TvPlayerButton"
+            android:contentDescription="Fast forward"
+            android:src="@drawable/ic_tv_fast_forward" />
+
+        <androidx.appcompat.widget.AppCompatImageButton
+            android:id="@+id/subtitles_button"
+            style="@style/TvPlayerButton"
+            android:contentDescription="Subtitles"
+            android:src="@drawable/ic_subtitles_stateful_24dp" />
+
+        <androidx.appcompat.widget.AppCompatImageButton
+            android:id="@+id/audio_streams_button"
+            style="@style/TvPlayerButton"
+            android:contentDescription="Audio"
+            android:src="@drawable/ic_music_note_white_24dp" />
+    </LinearLayout>
+
+    <TextView
+        android:id="@+id/tv_ends_at"
+        style="@style/TvPlayerText"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:layout_marginEnd="56dp"
+        android:layout_marginBottom="10dp"
+        android:textSize="18sp"
+        android:textStyle="bold"
+        app:layout_constraintBottom_toTopOf="@id/seek_bar_container"
+        app:layout_constraintEnd_toEndOf="parent" />
+
+    <!-- Progress bar -->
+    <androidx.constraintlayout.widget.ConstraintLayout
+        android:id="@+id/seek_bar_container"
+        android:layout_width="0dp"
+        android:layout_height="wrap_content"
+        android:layout_marginStart="44dp"
+        android:layout_marginEnd="44dp"
+        android:layout_marginBottom="4dp"
+        app:layout_constraintBottom_toTopOf="@id/tv_row_extra"
+        app:layout_constraintEnd_toEndOf="parent"
+        app:layout_constraintStart_toStartOf="parent">
+
+        <androidx.constraintlayout.widget.ConstraintLayout
+            android:id="@+id/chapter_marking_container"
+            android:layout_width="0dp"
+            android:layout_height="0dp"
+            android:layout_marginStart="11dp"
+            android:layout_marginEnd="11dp"
+            android:orientation="horizontal"
+            app:layout_constraintBottom_toBottomOf="parent"
+            app:layout_constraintEnd_toEndOf="parent"
+            app:layout_constraintStart_toStartOf="parent"
+            app:layout_constraintTop_toTopOf="parent" />
+
+        <androidx.media3.ui.DefaultTimeBar
+            android:id="@+id/exo_progress"
+            android:layout_width="0dp"
+            android:layout_height="wrap_content"
+            android:background="@drawable/tv_focus_bar"
+            app:bar_height="5dp"
+            app:buffered_color="#66FFFFFF"
+            app:layout_constraintBottom_toBottomOf="parent"
+            app:layout_constraintEnd_toEndOf="parent"
+            app:layout_constraintStart_toStartOf="parent"
+            app:layout_constraintTop_toTopOf="parent"
+            app:played_color="#A99AFF"
+            app:scrubber_color="#FFFFFF"
+            app:scrubber_dragged_size="24dp"
+            app:scrubber_enabled_size="16dp"
+            app:unplayed_color="#40FFFFFF" />
+    </androidx.constraintlayout.widget.ConstraintLayout>
+
+    <!-- Row 2: episode / chapter navigation, speed, quality, decoder, info, zoom -->
+    <LinearLayout
+        android:id="@+id/tv_row_extra"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:layout_marginStart="40dp"
+        android:layout_marginBottom="36dp"
+        android:gravity="center_vertical"
+        android:orientation="horizontal"
+        app:layout_constraintBottom_toBottomOf="parent"
+        app:layout_constraintStart_toStartOf="parent">
+
+        <androidx.appcompat.widget.AppCompatImageButton
+            android:id="@+id/previous_button"
+            style="@style/TvPlayerButton"
+            android:contentDescription="Previous"
+            android:src="@drawable/ic_skip_previous_black_32dp" />
+
+        <androidx.appcompat.widget.AppCompatImageButton
+            android:id="@+id/next_button"
+            style="@style/TvPlayerButton"
+            android:contentDescription="Next episode"
+            android:src="@drawable/ic_skip_next_black_32dp" />
+
+        <androidx.appcompat.widget.AppCompatImageButton
+            android:id="@+id/previous_chapter_button"
+            style="@style/TvPlayerButton"
+            android:contentDescription="Previous chapter"
+            android:src="@drawable/ic_skip_previous_chapter_black_32dp" />
+
+        <androidx.appcompat.widget.AppCompatImageButton
+            android:id="@+id/next_chapter_button"
+            style="@style/TvPlayerButton"
+            android:contentDescription="Next chapter"
+            android:src="@drawable/ic_skip_next_chapter_black_32dp" />
+
+        <androidx.appcompat.widget.AppCompatImageButton
+            android:id="@+id/speed_button"
+            style="@style/TvPlayerButton"
+            android:contentDescription="Playback speed"
+            android:src="@drawable/ic_slow_motion_video_white_24dp" />
+
+        <androidx.appcompat.widget.AppCompatImageButton
+            android:id="@+id/quality_button"
+            style="@style/TvPlayerButton"
+            android:contentDescription="Quality"
+            android:src="@drawable/ic_settings_white_24dp" />
+
+        <androidx.appcompat.widget.AppCompatImageButton
+            android:id="@+id/decoder_button"
+            style="@style/TvPlayerButton"
+            android:contentDescription="Decoder"
+            android:src="@drawable/ic_video_settings_white_24dp" />
+
+        <androidx.appcompat.widget.AppCompatImageButton
+            android:id="@+id/info_button"
+            style="@style/TvPlayerButton"
+            android:contentDescription="Playback info"
+            android:src="@drawable/ic_info_white_24dp" />
+
+        <androidx.appcompat.widget.AppCompatImageButton
+            android:id="@+id/tv_zoom_button"
+            style="@style/TvPlayerButton"
+            android:contentDescription="Zoom"
+            android:src="@drawable/ic_tv_aspect_ratio" />
+
+        <!-- Phone-only buttons, kept hidden for the shared player code -->
+        <androidx.appcompat.widget.AppCompatImageButton
+            android:id="@+id/lock_screen_button"
+            style="@style/TvPlayerButton"
+            android:src="@drawable/ic_screen_lock_white_24dp"
+            android:visibility="gone" />
+
+        <androidx.appcompat.widget.AppCompatImageButton
+            android:id="@+id/fullscreen_switcher"
+            style="@style/TvPlayerButton"
+            android:src="@drawable/ic_fullscreen_enter_white_32dp"
+            android:visibility="gone" />
+    </LinearLayout>
+
+    <!-- Bottom right: position / duration -->
+    <LinearLayout
+        android:id="@+id/tv_time_container"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:layout_marginEnd="56dp"
+        android:orientation="horizontal"
+        app:layout_constraintBottom_toBottomOf="@id/tv_row_extra"
+        app:layout_constraintEnd_toEndOf="parent"
+        app:layout_constraintTop_toTopOf="@id/tv_row_extra">
+
+        <androidx.appcompat.widget.AppCompatTextView
+            android:id="@+id/exo_position"
+            style="@style/TvPlayerText"
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:textSize="18sp"
+            android:textStyle="bold" />
+
+        <TextView
+            style="@style/TvPlayerText"
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:text="  /  "
+            android:textSize="18sp"
+            android:textStyle="bold" />
+
+        <androidx.appcompat.widget.AppCompatTextView
+            android:id="@+id/exo_duration"
+            style="@style/TvPlayerText"
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:textSize="18sp"
+            android:textStyle="bold" />
+    </LinearLayout>
+
+    <androidx.constraintlayout.widget.Barrier
+        android:id="@+id/controls_barrier"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        app:barrierDirection="top"
+        app:constraint_referenced_ids="tv_row_extra" />
+
+    <!-- Seek preview thumbnails (positioned in code above the progress bar) -->
+    <FrameLayout
+        android:id="@+id/trickplay_container"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:layout_marginBottom="12dp"
+        android:background="#282828"
+        android:elevation="8dp"
+        android:visibility="gone"
+        app:layout_constraintBottom_toTopOf="@id/seek_bar_container"
+        app:layout_constraintStart_toStartOf="parent">
+
+        <androidx.appcompat.widget.AppCompatImageView
+            android:id="@+id/trickplay_thumbnail"
+            android:layout_width="wrap_content"
+            android:layout_height="@dimen/trickplay_thumbnail_height"
+            android:scaleType="fitXY" />
+
+        <LinearLayout
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:layout_gravity="bottom"
+            android:orientation="vertical"
+            android:paddingStart="8dp"
+            android:paddingTop="4dp"
+            android:paddingEnd="8dp"
+            android:paddingBottom="8dp">
+
+            <androidx.appcompat.widget.AppCompatTextView
+                android:id="@+id/trickplay_chapter_name"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:alpha="0.9"
+                android:ellipsize="end"
+                android:maxLines="1"
+                android:shadowColor="#FF000000"
+                android:shadowRadius="6"
+                android:textColor="@android:color/white"
+                android:textSize="14sp"
+                android:visibility="gone" />
+
+            <androidx.appcompat.widget.AppCompatTextView
+                android:id="@+id/trickplay_time"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:layout_marginTop="4dp"
+                android:shadowColor="#FF000000"
+                android:shadowRadius="6"
+                android:textColor="@android:color/white"
+                android:textSize="20sp"
+                android:textStyle="bold" />
+        </LinearLayout>
+    </FrameLayout>
+</androidx.constraintlayout.widget.ConstraintLayout>
