+package org.jellyfin.mobile.webapp
+
+import android.webkit.WebView
+import androidx.webkit.ScriptHandler
+import androidx.webkit.WebMessageCompat
+import androidx.webkit.WebViewCompat
+import androidx.webkit.WebViewFeature
+import org.jellyfin.mobile.bridge.ExternalPlayer
+import org.jellyfin.mobile.bridge.MediaSegments
+import org.jellyfin.mobile.bridge.NativeInterface
+import org.jellyfin.mobile.bridge.NativePlayer
+import org.json.JSONArray
+import org.json.JSONObject
+import timber.log.Timber
+
+/** No addJavascriptInterface fallback: embedded/foreign frames never receive native privileges. */
+internal class OriginScopedBridge(
+    private val origin: ServerOrigin,
+    private val native: NativeInterface,
+    private val player: NativePlayer,
+    private val external: ExternalPlayer,
+    private val segments: MediaSegments,
+) {
+    private var script: ScriptHandler? = null
+
+    fun install(view: WebView): Boolean {
+        if (!WebViewFeature.isFeatureSupported(WebViewFeature.WEB_MESSAGE_LISTENER) ||
+            !WebViewFeature.isFeatureSupported(WebViewFeature.DOCUMENT_START_SCRIPT)
+        ) return false
+        WebViewCompat.addWebMessageListener(view, "TanukifinBridge", setOf(origin.rule)) {
+                webView, message, sourceOrigin, isMainFrame, _ ->
+            if (!isMainFrame || !origin.allows(sourceOrigin.toString()) ||
+                !origin.allows(webView.url.orEmpty()) || message.type != WebMessageCompat.TYPE_STRING
+            ) return@addWebMessageListener
+            val data = message.data ?: return@addWebMessageListener
+            if (data.length > MAX_MESSAGE_LENGTH) return@addWebMessageListener
+            runCatching {
+                val call = JSONObject(data)
+                dispatch(call.getString("method"), call.getJSONArray("args"))
+            }.onFailure {
+                // Never log message bodies, URLs or exception text containing caller input.
+                Timber.w("Rejected Tanukifin bridge command")
+            }
+        }
+        val bootstrap = view.context.assets.open("native/tanukifin-bridge.js").bufferedReader().use { it.readText() }
+        script = WebViewCompat.addDocumentStartJavaScript(view, "($bootstrap)(${configuration()});", setOf(origin.rule))
+        return true
+    }
+
+    private fun configuration(): JSONObject = JSONObject()
+            .put("origin", origin.rule)
+            .put("deviceInformation", native.getDeviceInformation())
+            .put("codecCapabilities", native.getCodecCapabilities())
+            .put("chromecast", native.hasChromecast())
+            .put("nativePlayer", player.isEnabled())
+            .put("externalPlayer", external.isEnabled())
+            .put("segmentTypes", segments.getSupportedSegmentTypes())
+
+    fun refresh(view: WebView) {
+        if (origin.allows(view.url.orEmpty())) {
+            view.evaluateJavascript(
+                "window.dispatchEvent(new CustomEvent('tanukifin-state', { detail: ${configuration()} }));",
+                null,
+            )
+        }
+    }
+
+    fun close(view: WebView) {
+        script?.remove()
+        script = null
+        if (WebViewFeature.isFeatureSupported(WebViewFeature.WEB_MESSAGE_LISTENER)) {
+            WebViewCompat.removeWebMessageListener(view, "TanukifinBridge")
+        }
+    }
+
+    private fun dispatch(method: String, args: JSONArray) {
+        // Explicit allowlist; arbitrary Java/Kotlin method invocation is never supported.
+        when (method) {
+            "NativeInterface.enableFullscreen" -> native.enableFullscreen()
+            "NativeInterface.disableFullscreen" -> native.disableFullscreen()
+            "NativeInterface.updateMediaSession" -> native.updateMediaSession(args.getString(0))
+            "NativeInterface.hideMediaSession" -> native.hideMediaSession()
+            "NativeInterface.updateVolumeLevel" -> native.updateVolumeLevel(args.getInt(0))
+            "NativeInterface.downloadFiles" -> native.downloadFiles(args.getString(0))
+            "NativeInterface.openDownloadManager" -> native.openDownloadManager()
+            "NativeInterface.openClientSettings" -> native.openClientSettings()
+            "NativeInterface.openServerSelection" -> native.openServerSelection()
+            "NativeInterface.exitApp" -> native.exitApp()
+            "NativeInterface.execCast" -> native.execCast(args.getString(0), args.getString(1))
+            "NativePlayer.loadPlayer" -> player.loadPlayer(args.getString(0), args.getString(1))
+            "NativePlayer.pausePlayer" -> player.pausePlayer()
+            "NativePlayer.resumePlayer" -> player.resumePlayer()
+            "NativePlayer.stopPlayer" -> player.stopPlayer()
+            "NativePlayer.destroyPlayer" -> player.destroyPlayer()
+            "NativePlayer.seekTicks" -> player.seekTicks(args.getLong(0))
+            "NativePlayer.seekMs" -> player.seekMs(args.getLong(0))
+            "NativePlayer.nextTrack" -> player.nextTrack()
+            "NativePlayer.previousTrack" -> player.previousTrack()
+            "NativePlayer.adjustVolume" -> player.adjustVolume(args.getInt(0))
+            "NativePlayer.setMuted" -> player.setMuted(args.getBoolean(0))
+            "NativePlayer.toggleMute" -> player.toggleMute()
+            "NativePlayer.seekRelative" -> player.seekRelative(args.getLong(0))
+            "NativePlayer.setAudioTrack" -> player.setAudioTrack(args.getInt(0))
+            "NativePlayer.setSubtitleTrack" -> player.setSubtitleTrack(args.getInt(0))
+            "NativePlayer.setVolume" -> player.setVolume(args.getInt(0))
+            "ExternalPlayer.initPlayer" -> external.initPlayer(args.getString(0))
+            "MediaSegments.setSegmentTypeAction" -> segments.setSegmentTypeAction(args.getString(0), args.getString(1))
+            else -> error("Unsupported bridge command")
+        }
+    }
+
+    companion object {
+        private const val MAX_MESSAGE_LENGTH = 524288
+    }
+}
